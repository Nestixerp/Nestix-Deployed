import React, { useState, useEffect } from 'react';
import { Card, CardContent, CardHeader, CardTitle } from '../components/ui/card';
import { Button } from '../components/ui/button';
import { Input } from '../components/ui/input';
import { Label } from '../components/ui/label';
import { Bar } from 'react-chartjs-2';
import {
  Chart as ChartJS,
  CategoryScale,
  LinearScale,
  BarElement,
  Title,
  Tooltip,
  Legend
} from 'chart.js';
import { Plus, Edit, Save, X, Printer } from 'lucide-react';

// Register ChartJS components
ChartJS.register(
  CategoryScale,
  LinearScale,
  BarElement,
  Title,
  Tooltip,
  Legend
);

const BACKEND_URL = process.env.REACT_APP_BACKEND_URL || 'http://localhost:8001';

const ElectricityUsage = () => {
  const [availableYears, setAvailableYears] = useState([]);
  const [selectedYear1, setSelectedYear1] = useState(2024);
  const [selectedYear2, setSelectedYear2] = useState(2025);
  const [comparisonData, setComparisonData] = useState(null);
  const [editMode, setEditMode] = useState(false);
  const [editingYear, setEditingYear] = useState(null);
  const [editingMetric, setEditingMetric] = useState('dollars'); // dollars, emissions, kwh
  const [formData, setFormData] = useState({
    january: 0, february: 0, march: 0, april: 0,
    may: 0, june: 0, july: 0, august: 0,
    september: 0, october: 0, november: 0, december: 0
  });

  useEffect(() => {
    fetchAvailableYears();
  }, []);

  useEffect(() => {
    if (availableYears.length >= 2) {
      setSelectedYear1(availableYears[1]);
      setSelectedYear2(availableYears[0]);
    }
  }, [availableYears]);

  useEffect(() => {
    if (selectedYear1 && selectedYear2) {
      fetchComparisonData();
    }
  }, [selectedYear1, selectedYear2]);

  const fetchAvailableYears = async () => {
    try {
      const currentUserStr = localStorage.getItem('currentUser');
      const currentUser = JSON.parse(currentUserStr);
      const token = currentUser.token;

      const response = await fetch(`${BACKEND_URL}/api/environmental/years/electricity`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const data = await response.json();
      setAvailableYears(data.years);
    } catch (error) {
      console.error('Error fetching years:', error);
    }
  };

  const fetchComparisonData = async () => {
    try {
      const currentUserStr = localStorage.getItem('currentUser');
      const currentUser = JSON.parse(currentUserStr);
      const token = currentUser.token;

      const response = await fetch(
        `${BACKEND_URL}/api/environmental/comparison-multi/electricity/${selectedYear1}/${selectedYear2}`,
        { headers: { 'Authorization': `Bearer ${token}` } }
      );
      const data = await response.json();
      setComparisonData(data);
    } catch (error) {
      console.error('Error fetching comparison data:', error);
    }
  };

  const handleAddYear = () => {
    const newYear = new Date().getFullYear();
    setEditingYear(newYear);
    setFormData({
      january: 0, february: 0, march: 0, april: 0,
      may: 0, june: 0, july: 0, august: 0,
      september: 0, october: 0, november: 0, december: 0
    });
    setEditMode(true);
  };

  const handleEditYear = (year, metric, data) => {
    setEditingYear(year);
    setEditingMetric(metric);
    setFormData({
      january: data?.january || 0,
      february: data?.february || 0,
      march: data?.march || 0,
      april: data?.april || 0,
      may: data?.may || 0,
      june: data?.june || 0,
      july: data?.july || 0,
      august: data?.august || 0,
      september: data?.september || 0,
      october: data?.october || 0,
      november: data?.november || 0,
      december: data?.december || 0
    });
    setEditMode(true);
  };

  const handleSave = async () => {
    try {
      const currentUserStr = localStorage.getItem('currentUser');
      const currentUser = JSON.parse(currentUserStr);
      const token = currentUser.token;

      const payload = {
        data_type: 'electricity',
        metric_type: editingMetric,
        year: editingYear,
        ...formData
      };

      // Check if updating or creating
      const metricData = comparisonData?.metrics?.[editingMetric];
      const existingData = metricData?.data_year1?.year === editingYear 
        ? metricData.data_year1 
        : metricData?.data_year2?.year === editingYear 
          ? metricData.data_year2 
          : null;

      let response;
      if (existingData && existingData.id) {
        // Update
        response = await fetch(`${BACKEND_URL}/api/environmental/data/${existingData.id}`, {
          method: 'PUT',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(formData)
        });
      } else {
        // Create
        response = await fetch(`${BACKEND_URL}/api/environmental/data`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        });
      }

      if (response.ok) {
        alert('Data saved successfully!');
        setEditMode(false);
        fetchAvailableYears();
        fetchComparisonData();
      } else {
        const error = await response.json();
        alert('Error: ' + (error.detail || 'Failed to save'));
      }
    } catch (error) {
      console.error('Error saving data:', error);
      alert('Error saving data');
    }
  };

  const handlePrintChart = () => {
    const printWindow = window.open('', '_blank');
    printWindow.document.write(`
      <!DOCTYPE html>
      <html>
      <head>
        <title>Electricity Usage Report - ${selectedYear1} vs ${selectedYear2}</title>
        <style>
          body { 
            font-family: Arial, sans-serif; 
            margin: 20px; 
            padding: 0;
          }
          h1 { 
            text-align: center; 
            color: #333; 
            margin-bottom: 10px;
          }
          .subtitle {
            text-align: center;
            color: #666;
            margin-bottom: 20px;
          }
          .stats {
            text-align: center;
            margin: 20px 0;
            padding: 15px;
            background: #f5f5f5;
            border-radius: 8px;
          }
          .change-indicator {
            font-size: 18px;
            font-weight: bold;
            margin: 10px 0;
          }
          .reduction { color: #16a34a; }
          .increase { color: #dc2626; }
          canvas { 
            max-width: 100%; 
            height: auto !important;
          }
          @media print {
            body { margin: 0; }
            button { display: none; }
          }
        </style>
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
      </head>
      <body>
        <h1>Electricity Usage Comparison Report</h1>
        <div class="subtitle">Year ${selectedYear1} vs Year ${selectedYear2}</div>
        <div class="stats">
          <div class="change-indicator ${comparisonData?.is_reduction ? 'reduction' : 'increase'}">
            ${comparisonData?.is_reduction ? '✅ Reduction' : '❌ Increase'}: ${Math.abs(comparisonData?.total_change_percent || 0)}%
          </div>
          <div style="color: #666; margin-top: 5px;">
            Total ${selectedYear1}: ${comparisonData?.data_year1?.total || 0} kWh | 
            Total ${selectedYear2}: ${comparisonData?.data_year2?.total || 0} kWh
          </div>
        </div>
        <canvas id="chart"></canvas>
        <div style="text-align: center; margin-top: 20px;">
          <button onclick="window.print()" style="padding: 10px 20px; background: #333; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 16px;">
            Print Report
          </button>
        </div>
        <script>
          const ctx = document.getElementById('chart').getContext('2d');
          const chartData = ${JSON.stringify(chartData)};
          const chartOptions = ${JSON.stringify(chartOptions)};
          new Chart(ctx, {
            type: 'line',
            data: chartData,
            options: {
              ...chartOptions,
              responsive: true,
              maintainAspectRatio: true
            }
          });
        </script>
      </body>
      </html>
    `);
    printWindow.document.close();
  };

  const chartData = {
    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
    datasets: [
      {
        label: selectedYear1.toString(),
        data: comparisonData?.data_year1 ? [
          comparisonData.data_year1.january,
          comparisonData.data_year1.february,
          comparisonData.data_year1.march,
          comparisonData.data_year1.april,
          comparisonData.data_year1.may,
          comparisonData.data_year1.june,
          comparisonData.data_year1.july,
          comparisonData.data_year1.august,
          comparisonData.data_year1.september,
          comparisonData.data_year1.october,
          comparisonData.data_year1.november,
          comparisonData.data_year1.december
        ] : [],
        borderColor: 'rgb(59, 130, 246)',
        backgroundColor: 'rgba(59, 130, 246, 0.5)',
        tension: 0.1
      },
      {
        label: selectedYear2.toString(),
        data: comparisonData?.data_year2 ? [
          comparisonData.data_year2.january,
          comparisonData.data_year2.february,
          comparisonData.data_year2.march,
          comparisonData.data_year2.april,
          comparisonData.data_year2.may,
          comparisonData.data_year2.june,
          comparisonData.data_year2.july,
          comparisonData.data_year2.august,
          comparisonData.data_year2.september,
          comparisonData.data_year2.october,
          comparisonData.data_year2.november,
          comparisonData.data_year2.december
        ] : [],
        borderColor: 'rgb(34, 197, 94)',
        backgroundColor: 'rgba(34, 197, 94, 0.5)',
        tension: 0.1
      }
    ]
  };

  const chartOptions = {
    responsive: true,
    plugins: {
      legend: {
        position: 'top',
      },
      title: {
        display: true,
        text: `ELECTRICITY USAGE ${selectedYear1} / ${selectedYear2} - TARGET: REDUCTION IN GREENHOUSE GASES`,
        font: {
          size: 16,
          weight: 'bold'
        }
      }
    },
    scales: {
      y: {
        beginAtZero: true,
        title: {
          display: true,
          text: 'kWh'
        }
      }
    }
  };

  return (
    <div className="p-6 space-y-6">
      {/* Header */}
      <div className="flex justify-between items-center">
        <div>
          <h1 className="text-3xl font-bold text-gray-900">Electricity Usage (ISO/IMS)</h1>
          <p className="text-gray-600 mt-1">Track monthly electricity consumption</p>
        </div>
        <Button onClick={handleAddYear}>
          <Plus className="w-4 h-4 mr-2" />
          Add Year Data
        </Button>
      </div>

      {/* Year Comparison Selector */}
      <Card>
        <CardHeader>
          <CardTitle>Compare Years</CardTitle>
        </CardHeader>
        <CardContent className="space-y-4">
          <div className="grid grid-cols-2 gap-4">
            <div>
              <Label>Year 1 (Previous)</Label>
              <select
                className="w-full border rounded p-2"
                value={selectedYear1}
                onChange={(e) => setSelectedYear1(parseInt(e.target.value))}
              >
                {availableYears.map(year => (
                  <option key={year} value={year}>{year}</option>
                ))}
              </select>
            </div>
            <div>
              <Label>Year 2 (Current)</Label>
              <select
                className="w-full border rounded p-2"
                value={selectedYear2}
                onChange={(e) => setSelectedYear2(parseInt(e.target.value))}
              >
                {availableYears.map(year => (
                  <option key={year} value={year}>{year}</option>
                ))}
              </select>
            </div>
          </div>
          {comparisonData && (
            <div className="flex gap-4 justify-center">
              <Button
                size="sm"
                variant="outline"
                onClick={() => handleEditYear(selectedYear1, comparisonData.data_year1)}
              >
                <Edit className="w-4 h-4 mr-2" />
                Edit {selectedYear1}
              </Button>
              <Button
                size="sm"
                variant="outline"
                onClick={() => handleEditYear(selectedYear2, comparisonData.data_year2)}
              >
                <Edit className="w-4 h-4 mr-2" />
                Edit {selectedYear2}
              </Button>
              <Button
                size="sm"
                variant="default"
                onClick={handlePrintChart}
              >
                <Printer className="w-4 h-4 mr-2" />
                Print Chart
              </Button>
            </div>
          )}
        </CardContent>
      </Card>

      {/* Chart */}
      {comparisonData && (
        <Card>
          <CardContent className="pt-6">
            <Line data={chartData} options={chartOptions} />
            {comparisonData.total_change_percent !== 0 && (
              <div className="mt-4 text-center">
                <p className={`text-lg font-bold ${comparisonData.is_reduction ? 'text-green-600' : 'text-red-600'}`}>
                  {comparisonData.is_reduction ? '✅ Reduction: ' : '❌ Increase: '}
                  {Math.abs(comparisonData.total_change_percent)}%
                </p>
                <p className="text-sm text-gray-600">
                  Total {selectedYear1}: {comparisonData.data_year1?.total || 0} kWh | 
                  Total {selectedYear2}: {comparisonData.data_year2?.total || 0} kWh
                </p>
              </div>
            )}
          </CardContent>
        </Card>
      )}

      {/* Edit Dialog */}
      {editMode && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
          <Card className="w-full max-w-4xl max-h-[90vh] overflow-y-auto">
            <CardHeader>
              <CardTitle>Edit Electricity Data - {editingYear}</CardTitle>
            </CardHeader>
            <CardContent className="space-y-4">
              <div className="grid grid-cols-4 gap-4">
                {Object.keys(formData).map((month) => (
                  <div key={month}>
                    <Label className="capitalize">{month}</Label>
                    <Input
                      type="number"
                      value={formData[month]}
                      onChange={(e) => setFormData({...formData, [month]: parseFloat(e.target.value) || 0})}
                      placeholder="kWh"
                    />
                  </div>
                ))}
              </div>
              <div className="flex gap-2 pt-4">
                <Button onClick={handleSave} className="flex-1">
                  <Save className="w-4 h-4 mr-2" />
                  Save Data
                </Button>
                <Button
                  variant="outline"
                  onClick={() => setEditMode(false)}
                  className="flex-1"
                >
                  <X className="w-4 h-4 mr-2" />
                  Cancel
                </Button>
              </div>
            </CardContent>
          </Card>
        </div>
      )}
    </div>
  );
};

export default ElectricityUsage;
